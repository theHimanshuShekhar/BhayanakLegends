{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BhayanakLegends",
  "identifier": "com.bhayanaklegends.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rift Coach",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3MTkwNzczQjNFRUYxRDgKUldUWThlNnpjd2NaMTF1U2x2M1N3dEpYQkx4K3YrMC9GVVJKaTFvQk1sa0lwcTh1Nzd4MFh3YUwK",
      "endpoints": [
        "https://CHANGE-ME.github.io/CHANGE-ME/latest.json"
      ]
    }
  }
}