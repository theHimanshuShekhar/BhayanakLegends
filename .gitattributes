# Findings Pack source JSON is byte-pinned and must stay LF on every checkout.
/pack/*.json text eol=lf
/pack/models/*.json text eol=lf

# Model binaries and release archives are opaque bytes; never normalize them.
/pack/**/*.onnx binary -text
/pack/**/*.zip binary -text

# Historical live assets are test-only and retain exact bytes on Windows.
/backend/tests/fixtures/available_live_v5/*.json text eol=lf
/backend/tests/fixtures/available_live_v5/*.onnx binary -text
